{
  // Merged config for markdownlint-cli2 (previously split between
  // `.config/markdownlint.json` and root `.markdownlint-cli2.jsonc`).
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false
  },
  "fix": true,
  "globs": ["**/*.md", "**/*.markdown"],
  "gitignore": true
}
